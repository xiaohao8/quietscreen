<UserControl x:Class="QuietScreen.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnRefresh" Style="{StaticResource BtnDark}" Content="刷新" Click="BtnRefresh_Click"/>
            <Button x:Name="BtnOpenFile" Style="{StaticResource BtnDark}" Content="打开日志文件" Margin="10,0,0,0"
                    Click="BtnOpenFile_Click"/>
            <Button x:Name="BtnFollow" Style="{StaticResource BtnDark}" Content="自动刷新: 关" Margin="10,0,0,0"
                    Click="BtnFollow_Click"/>
        </StackPanel>
        <Border Grid.Row="1" Background="#FF101018" CornerRadius="10" Padding="12">
            <TextBox x:Name="LogBox" Background="Transparent" BorderThickness="0" Foreground="#FFC9C9DC"
                     FontFamily="Consolas" FontSize="12" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     TextChanged="LogBox_TextChanged"/>
        </Border>
    </Grid>
</UserControl>
