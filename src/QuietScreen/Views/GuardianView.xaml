<UserControl x:Class="QuietScreen.Views.GuardianView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 守护开关 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="守护模式" Style="{StaticResource H2}"/>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                                   Text="定期检查主屏是否为虚拟屏, 不在则自动重建; 同时守护向日葵代理。关闭窗口后仍随托盘常驻。"/>
                    </StackPanel>
                    <ToggleButton x:Name="GuardSwitch" Style="{StaticResource Switch}"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Checked="GuardSwitch_Changed" Unchecked="GuardSwitch_Changed"/>
                </Grid>
            </Border>

            <!-- 实时状态 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="实时状态" Style="{StaticResource H2}"/>
                        <Button x:Name="BtnCheckNow" Style="{StaticResource BtnPrimary}" Content="立即检查一次"
                                HorizontalAlignment="Right" Margin="0,-8,0,0" Click="BtnCheckNow_Click"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                            <RowDefinition Height="28"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="主屏" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StatPrimary" Grid.Column="1" Style="{StaticResource Body}" Text="—"/>
                        <TextBlock Text="远控代理" Grid.Row="1" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StatAgent" Grid.Row="1" Grid.Column="1" Style="{StaticResource Body}" Text="—"/>
                        <TextBlock Text="检查次数" Grid.Row="2" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StatChecks" Grid.Row="2" Grid.Column="1" Style="{StaticResource Body}" Text="0"/>
                        <TextBlock Text="恢复次数" Grid.Row="3" Style="{StaticResource Sub}"/>
                        <TextBlock x:Name="StatRepairs" Grid.Row="3" Grid.Column="1" Style="{StaticResource Body}" Text="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 检查选项 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="检查选项" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="40"/>
                            <RowDefinition Height="46"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="主屏不是虚拟屏时自动重建" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="OptAutoCreate" Grid.Column="1" Style="{StaticResource Switch}"
                                      Checked="Opt_Changed" Unchecked="Opt_Changed"/>

                        <TextBlock Text="恢复后切换仅第二屏 (熄灭内屏)" Grid.Row="1" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="OptSwitchExternal" Grid.Row="1" Grid.Column="1" Style="{StaticResource Switch}"
                                      Checked="Opt_Changed" Unchecked="Opt_Changed"/>

                        <TextBlock Text="重建前先清掉多余虚拟屏" Grid.Row="2" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="OptClean" Grid.Row="2" Grid.Column="1" Style="{StaticResource Switch}"
                                      Checked="Opt_Changed" Unchecked="Opt_Changed"/>

                        <TextBlock Text="有变化时弹 Windows 通知" Grid.Row="3" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="OptToast" Grid.Row="3" Grid.Column="1" Style="{StaticResource Switch}"
                                      Checked="Opt_Changed" Unchecked="Opt_Changed"/>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="检查间隔" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                            <TextBox x:Name="IntervalBox" Style="{StaticResource DarkTextBox}" Width="64" Margin="10,0,6,0"
                                     LostFocus="Interval_Changed" Text="45"/>
                            <TextBlock Text="秒 (最小 10)" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 代理守护 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="远控代理守护 (向日葵)" Style="{StaticResource H2}"/>
                            <TextBlock Text="检测代理端口是否监听, 不在则自动拉起。" Style="{StaticResource Sub}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <ToggleButton x:Name="AgentSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" Checked="AgentSwitch_Changed" Unchecked="AgentSwitch_Changed"/>
                    </Grid>
                    <TextBlock Text="代理程序路径" Style="{StaticResource Sub}" Margin="0,0,0,4"/>
                    <TextBox x:Name="AgentExeBox" Style="{StaticResource DarkTextBox}" LostFocus="Agent_Changed"/>
                    <TextBlock Text="启动参数" Style="{StaticResource Sub}" Margin="0,8,0,4"/>
                    <TextBox x:Name="AgentArgsBox" Style="{StaticResource DarkTextBox}" LostFocus="Agent_Changed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="监听端口" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <TextBox x:Name="AgentPortBox" Style="{StaticResource DarkTextBox}" Width="90" Margin="10,0,0,0"
                                 LostFocus="Agent_Changed"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
