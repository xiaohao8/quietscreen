<UserControl x:Class="QuietScreen.Views.ShutdownView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 状态 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="关机计划状态" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Sub}" Margin="0,6,0,0"
                                   Text="当前没有已安排的关机"/>
                    </StackPanel>
                    <Button x:Name="BtnAbort" Style="{StaticResource BtnDanger}" Content="取消已安排的关机"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnAbort_Click"/>
                </Grid>
            </Border>

            <!-- 每日定时 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="每日定时关机" Style="{StaticResource H2}"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0"
                                       Text="到点后先弹系统倒计时 (宽限期内可取消), 适合宿舍晚上到点自动关机。"/>
                        </StackPanel>
                        <ToggleButton x:Name="DailySwitch" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="Daily_Changed" Unchecked="Daily_Changed"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="每天" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="TimeBox" Width="110" Margin="10,0,6,0" SelectionChanged="Time_SelectionChanged"/>
                        <TextBlock Text="自动关机" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="宽限时间" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="GraceBox" Width="90" Margin="10,0,6,0" SelectionChanged="Grace_SelectionChanged"/>
                        <TextBlock Text="触发后倒计时, 期间可取消" Style="{StaticResource Sub}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 立即安排 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="临时安排" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,12"
                               Text="从现在起倒计时, 同样走系统关机, 可随时点上面的取消。" />
                    <UniformGrid Columns="3">
                        <Button Style="{StaticResource BtnDark}" Margin="0,0,8,0" Padding="0,12" Content="30 分钟后关机" Click="Quick_Click" Tag="1800"/>
                        <Button Style="{StaticResource BtnDark}" Margin="8,0,8,0" Padding="0,12" Content="60 分钟后关机" Click="Quick_Click" Tag="3600"/>
                        <Button Style="{StaticResource BtnDanger}" Margin="8,0,0,0" Padding="0,12" Content="10 分钟后关机" Click="Quick_Click" Tag="600"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <TextBlock Style="{StaticResource Sub}"
                           Text="可靠性说明: 倒计时由 Windows 系统接管 (shutdown /s /t), 程序崩溃倒计时依然有效; 取消走 shutdown /a, 无竞态。远控场景下关机前请保存好工作。"/>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
