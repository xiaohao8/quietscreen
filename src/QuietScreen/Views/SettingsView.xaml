<UserControl x:Class="QuietScreen.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!-- 驱动 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DrvDot" Width="10" Height="10" VerticalAlignment="Center"
                                     Margin="0,0,9,0" Fill="{StaticResource BrushYellow}"/>
                            <TextBlock x:Name="DrvText" Text="检测中..." Style="{StaticResource H2}"/>
                        </StackPanel>
                        <Button x:Name="BtnDrvRefresh" Style="{StaticResource BtnDark}" Content="重新检测"
                                HorizontalAlignment="Right" Click="BtnDrvRefresh_Click"/>
                    </Grid>
                    <TextBlock x:Name="DrvSub" Style="{StaticResource Sub}" Text="Parsec 虚拟屏驱动"/>
                    <StackPanel x:Name="DrvHelpPanel" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button x:Name="BtnDrvFolder" Style="{StaticResource BtnDark}" Content="打开驱动安装包所在文件夹"
                                Click="BtnDrvFolder_Click"/>
                        <Button Style="{StaticResource BtnDark}" Content="打开项目主页" Margin="10,0,0,0"
                                Click="BtnDrvHome_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 识别规则 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="虚拟屏识别规则" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,8"
                               Text="Parsec 虚拟屏自动识别; 此正则用于兼容其他虚拟屏软件的设备名 (如 DISPLAY20-DISPLAY39)。"/>
                    <TextBox x:Name="PatternBox" Style="{StaticResource DarkTextBox}" LostFocus="PatternBox_LostFocus"/>
                </StackPanel>
            </Border>

            <!-- 自启动 -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="开机自启动" Style="{StaticResource H2}"/>
                        <TextBlock x:Name="AutoStartText" Text="未开启" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnAutoOn" Style="{StaticResource BtnDark}" Content="开启" Click="BtnAutoOn_Click"/>
                        <Button x:Name="BtnAutoOff" Style="{StaticResource BtnDark}" Content="关闭" Margin="8,0,0,0" Click="BtnAutoOff_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 夜间常驻 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="夜间常驻" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="阻止系统自动睡眠" Style="{StaticResource Body}"/>
                            <TextBlock Style="{StaticResource Sub}" Margin="0,3,0,0"
                                       Text="程序运行期间不会睡眠/休眠/熄屏 (远控不掉线), 退出程序即恢复系统默认。"/>
                        </StackPanel>
                        <ToggleButton x:Name="PreventSleepSwitch" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="PreventSleep_Changed" Unchecked="PreventSleep_Changed"/>
                    </Grid>
                    <TextBlock Text="全局热键 (随程序运行生效)" Style="{StaticResource Body}" Margin="0,4,0,4"/>
                    <TextBlock x:Name="HotkeyText" Style="{StaticResource Sub}" Text="—"/>
                </StackPanel>
            </Border>

            <!-- 键盘熄灯 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="外设键盘熄灯" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,0,0,8"
                               Text="LT84 不开放灯光协议, GitHub/OpenRGB 均无插件。程序会在息屏/恢复时自动尝试: 优先 Windows 标准灯效接口 (LampArray), 不支持则模拟方向键 (Fn 键软件发不出, 无效时用键盘组合键)。"/>
                    <Border Background="{StaticResource BrushCard2}" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Body}" Text="LT84 专用自定义键    按一下循环切换灯效, 循环到熄灭"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="Fn + ↓    亮度调低 (按到熄灭)"/>
                            <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0" Text="Fn + F11 / Fn + F12    直接开关背光 (视批次而定)"/>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="LampCapText" Style="{StaticResource Sub}" Margin="0,0,0,8" Text="灯效设备: 检测中..."/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnLightsOff" Style="{StaticResource BtnDark}" Content="立即尝试熄灯" Click="BtnLightsOff_Click"/>
                        <Button x:Name="BtnOpenRgbOff" Style="{StaticResource BtnDark}" Content="通过 OpenRGB 熄灯" Margin="10,0,0,0"
                                Click="BtnOpenRgbOff_Click"/>
                        <Button Style="{StaticResource BtnDark}" Content="OpenRGB 官网" Margin="10,0,0,0"
                                Click="BtnOpenRgbSite_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 文件 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="配置与日志" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnDark}" Content="打开配置文件夹" Click="BtnCfgFolder_Click"/>
                        <Button Style="{StaticResource BtnDark}" Content="查看日志文件" Margin="10,0,0,0" Click="BtnLog_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="CfgPathText" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource H2}" Margin="0,0,0,6"/>
                    <TextBlock Style="{StaticResource Sub}"
                               Text="QuietScreen 虚拟屏管家 v1.0.0 — 虚拟屏守护与息屏远控工具。"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,6,0,0"
                               Text="虚拟屏控制能力移植自开源项目 nomi-san/parsec-vdd (MIT License), https://github.com/nomi-san/parsec-vdd"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                               Text="内置驱动包为 Parsec Cloud Inc. 官方原版 parsec-vdd v0.45, 安装方式与上述开源项目一致。"/>
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0"
                               Text="使用前请先在驱动设置中开启 Keep Screen On (保持屏幕常亮), 否则虚拟屏会被系统收回。"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
